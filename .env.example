# Environment Configuration for ECM Community Platform
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ── Required ────────────────────────────────────────────────────────────────
# Get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ── Optional ───────────────────────────────────────────────────────────────
# Admin password for Settings and Admin pages.
# If unset, Settings is freely accessible and Admin is disabled.
ADMIN_PASSWORD=

# Directory for votes.db (defaults to the application directory).
# Set this to a persistent path when running multiple environments (dev/staging).
ECM_DATA_DIR=
